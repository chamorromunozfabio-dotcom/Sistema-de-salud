# Base de Datos PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/saludpublica?schema=public"

# Configuración Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Servidor Backend
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Seguridad JWT
JWT_SECRET=tu_secreto_super_seguro_aqui_cambiar_en_produccion_32chars_min
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Configuración de Servidor SMTP (Gmail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tu_email@gmail.com
EMAIL_PASS=tu_app_password
EMAIL_FROM="SaludPública Connect <noreply@saludpublica.com>"

# IA - Google Gemini - obtener en https://aistudio.google.com/api-keys?project=gen-lang-client-0915724663
# Modelo usado: gemini-3.6-flash (actualizado 2026, gemini-1.5/2.5 ya no disponible para cuentas nuevas)
GEMINI_API_KEY=tu_api_key_de_google_ai
